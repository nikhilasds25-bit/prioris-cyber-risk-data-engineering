# Local PostgreSQL connection. Never commit a real .env file or credentials.
DATABASE_URL=postgresql+psycopg://prioris:change-me@localhost:5432/prioris
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Generate a unique secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required on deployments before enabling enterprise registration/login.
AUTH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
