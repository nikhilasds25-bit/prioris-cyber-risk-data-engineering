    {
      "id": "openssl_heartbleed_101f_before_101g",
      "status": "supported",
      "kind": "criterion_match",
      "source_term": "openssl",
      "installations": ["openssl_1_0_1f"],
      "expected": ["openssl_1_0_1f"],
      "reference_ids": ["nvd_cve_api_records", "nvd_api_schema", "openssl_security_advisory", "openssl_release_history"],
      "investigation": {
        "evidence": "NVD's CVE record states OpenSSL 1.0.1 before 1.0.1g and carries the staged 1.0.1 inclusive / 1.0.1g exclusive criterion. The OpenSSL advisory says 1.0.1 releases including 1.0.1f are affected and users should upgrade to 1.0.1g. Upstream NEWS records the 1.0.1f-to-1.0.1g release and CVE-2014-0160 fix.",
        "decision": "A narrowly scoped comparison for this exact NVD matchCriteriaId and only the documented versions 1.0.1, 1.0.1f, and 1.0.1g is defensible. No generic suffix or lexical ordering is inferred."
      },
      "justification": "The OpenSSL advisory directly identifies 1.0.1f as affected and 1.0.1g as the required upgrade. The implementation therefore evaluates this one exact NVD criterion with a source-backed version table."
    },
    {
      "id": "openssl_heartbleed_101g_exclusive_boundary",
      "status": "supported",
      "kind": "criterion_match",
      "source_term": "openssl",
      "installations": ["openssl_1_0_1g"],
      "expected": [],
      "reference_ids": ["nvd_cve_api_records", "nvd_api_schema", "openssl_security_advisory", "openssl_release_history"],
      "investigation": {
        "evidence": "The staged NVD criterion has versionEndExcluding 1.0.1g; the OpenSSL advisory names 1.0.1g as the upgrade version, and upstream NEWS records the f-to-g release boundary.",
        "decision": "The exact 1.0.1g boundary is excluded for the specific staged criterion."
      },
      "justification": "The locally staged criterion is explicitly exclusive at version 1.0.1g."
    },
    {
      "id": "openssl_unlisted_alpha_suffix_remains_unsupported",
      "status": "unsupported",
      "kind": "criterion_match",
      "source_term": "openssl",
      "installations": ["openssl_1_0_1e"],
      "expected": null,
      "expected_unsupported_assets": ["asset-1"],
      "reference_ids": ["nvd_cve_api_records", "openssl_security_advisory", "openssl_release_history"],
      "investigation": {
        "evidence": "The advisory explicitly names 1.0.1f among affected releases and 1.0.1g as the upgrade target; the constrained implementation does not encode an unverified 1.0.1e comparison.",
        "decision": "Keep unlisted suffixes unsupported rather than extrapolating a generic alphabetic release order."
      },
      "justification": "Evidence sufficient for the 1.0.1f / 1.0.1g boundary does not authorize general ordering of other suffixes."
    },
    {
      "id": "numeric_version_zero_padding_equivalence",
      "status": "pending_review",
      "kind": "version_compare",
      "left": "1.0",
      "right": "1.0.0",
      "expected": null,
      "reference_ids": ["nist_cpe_name_matching", "nvd_api_schema"],
      "investigation": {
        "evidence": "The NVD schema represents version bounds as strings and does not define a universal numeric component-padding equivalence rule. CPE Name Matching specifies name attribute matching, not a product-independent software release ordering.",
        "decision": "No expected equivalence/order is asserted. The matcher now reports different component counts as unsupported instead of padding with zero."
      },
      "justification": "Whether 1.0 and 1.0.0 denote equivalent or ordered releases is product-specific and unsupported by the cited general format/schema evidence."
    },
